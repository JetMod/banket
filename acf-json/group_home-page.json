                    "layout": "block",
                    "sub_fields": [
                        {
                            "key": "field_hero_rating_value",
                            "label": "Значение рейтинга",
                            "name": "value",
                            "type": "text",
                            "default_value": "5.0",
                            "placeholder": "5.0"
                        },
                        {
                            "key": "field_hero_rating_text",
                            "label": "Текст рейтинга",
                            "name": "text",
                            "type": "text",
                            "default_value": "рейтинг",
                            "placeholder": "рейтинг"
                        }
                    ]
                },
                {
                    "key": "field_hero_button_primary",
                    "label": "Основная кнопка",
                    "name": "button_primary",
                    "type": "group",
                    "layout": "block",
                    "sub_fields": [
                        {
                            "key": "field_hero_button_primary_text",
                            "label": "Текст кнопки",
                            "name": "text",
                            "type": "text",
                            "default_value": "Забронировать",
                            "placeholder": "Забронировать"
                        },
                        {
                            "key": "field_hero_button_primary_action",
                            "label": "Действие",
                            "name": "action",
                            "type": "text",
                            "default_value": "open-booking",
                            "placeholder": "open-booking"
                        }
                    ]
                },
                {
                    "key": "field_hero_button_secondary",
                    "label": "Вторичная кнопка",
                    "name": "button_secondary",
                    "type": "group",
                    "layout": "block",
                    "sub_fields": [
                        {
                            "key": "field_hero_button_secondary_text",
                            "label": "Текст кнопки",
                            "name": "text",
                            "type": "text",
                            "default_value": "Узнать больше",
                            "placeholder": "Узнать больше"
                        },
                        {
                            "key": "field_hero_button_secondary_scroll",
                            "label": "Якорь для прокрутки",
                            "name": "scroll_to",
                            "type": "text",
                            "default_value": "#about",
                            "placeholder": "#about"
                        }
                    ]
                },
                {
                    "key": "field_hero_info",
                    "label": "Информационные блоки",
                    "name": "info",
                    "type": "repeater",
                    "layout": "block",
                    "min": 3,
                    "max": 3,
                    "button_label": "Добавить блок",
                    "sub_fields": [
                        {
                            "key": "field_hero_info_type",
                            "label": "Тип блока",
                            "name": "type",
                            "type": "select",
                            "choices": {
                                "guests": "Гости",
                                "premium": "Премиум",
                                "halal": "Халяль"
                            },
                            "default_value": "guests"
                        },
                        {
                            "key": "field_hero_info_number",
                            "label": "Число (для типа 'Гости')",
                            "name": "number",
                            "type": "text",
                            "conditional_logic": [
                                [
                                    {
                                        "field": "field_hero_info_type",
                                        "operator": "==",
                                        "value": "guests"
                                    }
                                ]
                            ],
                            "default_value": "300"
                        },
                        {
                            "key": "field_hero_info_text",
                            "label": "Текст",
                            "name": "text",
                            "type": "text"
                        }
                    ],
                    "default_value": [
                        {
                            "type": "guests",
                            "number": "300",
                            "text": "гостей"
                        },
                        {
                            "type": "premium",
                            "text": "премиум"
                        },
                        {
                            "type": "halal",
                            "text": "халяль"
                        }
                    ]
                },
                {
                    "key": "field_hero_slider",
                    "label": "Слайдер изображений",
                    "name": "slider",
                    "type": "gallery",
                    "instructions": "Изображения для слайдера Hero секции",
                    "return_format": "array",
                    "preview_size": "medium",
                    "insert": "append",
                    "library": "all",
                    "min": 1
                }
            ]
        },
        {
            "key": "field_about_section",
            "label": "Секция О нас",
