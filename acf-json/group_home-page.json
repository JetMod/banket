                    "name": "title",
                    "type": "text",
                    "default_value": "Банкетный зал Shen Crystal",
                    "placeholder": "Банкетный зал Shen Crystal"
                },
                {
                    "key": "field_about_text",
                    "label": "Описание",
                    "name": "text",
                    "type": "textarea",
                    "default_value": "Shen Crystal — это многопрофильный банкетный зал премиум-класса, объединяющий в себе элегантность, функциональность и безупречный сервис. Мы создали идеальное пространство для проведения самых разноплановых мероприятий: от торжественных корпоративных праздников и церемоний вручения премий до презентаций новых продуктов и бизнес-конференций. Наш зал вмещает до 300 гостей и готов принять ваше мероприятие любого масштаба.",
                    "rows": 5
                },
                {
                    "key": "field_about_stats",
                    "label": "Статистика",
                    "name": "stats",
                    "type": "repeater",
                    "layout": "table",
                    "min": 3,
                    "max": 3,
                    "button_label": "Добавить статистику",
