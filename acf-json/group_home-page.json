                    "default_value": [
                        {
                            "number": "300",
                            "label": "Гостей"
                        },
                        {
                            "number": "100%",
                            "label": "Качество"
                        },
                        {
                            "number": "24/7",
                            "label": "Поддержка"
                        }
                    ]
                },
                {
                    "key": "field_about_slider",
                    "label": "Слайдер изображений",
                    "name": "slider",
                    "type": "gallery",
                    "instructions": "Изображения для слайдера секции О нас",
                    "return_format": "array",
                    "preview_size": "medium",
                    "insert": "append",
                    "library": "all",
                    "min": 1
                }
            ]
