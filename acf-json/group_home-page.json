            "instructions": "Настройки главного экрана",
            "layout": "block",
            "sub_fields": [
                {
                    "key": "field_hero_title",
                    "label": "Заголовок",
                    "name": "title",
                    "type": "text",
                    "default_value": "Банкетный зал",
                    "placeholder": "Банкетный зал"
                },
                {
                    "key": "field_hero_title_accent",
                    "label": "Акцентный заголовок",
                    "name": "title_accent",
                    "type": "text",
                    "default_value": "ShenCrystal",
                    "placeholder": "ShenCrystal"
                },
                {
                    "key": "field_hero_slogan",
                    "label": "Слоган",
                    "name": "slogan",
                    "type": "text",
                    "default_value": "✨ Нет предела совершенству ✨",
                    "placeholder": "✨ Нет предела совершенству ✨"
                },
                {
                    "key": "field_hero_rating",
                    "label": "Рейтинг",
                    "name": "rating",
