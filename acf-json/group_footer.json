                            "url": "/мероприятия/#wedding"
                        },
                        {
                            "text": "Дни рождения",
                            "url": "/мероприятия/#birthday"
                        },
                        {
                            "text": "Конференции",
                            "url": "/мероприятия/#conference"
                        }
                    ]
                }
