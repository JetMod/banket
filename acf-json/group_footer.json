            "instructions": "Настройки колонки контактов",
            "layout": "block",
            "sub_fields": [
                {
                    "key": "field_footer_contacts_title",
                    "label": "Заголовок колонки",
                    "name": "title",
                    "type": "text",
                    "default_value": "Контакты",
                    "placeholder": "Контакты",
                    "required": 1
                },
                {
                    "key": "field_footer_contacts_phone",
                    "label": "Телефон",
                    "name": "phone",
                    "type": "text",
                    "default_value": "+7 (978) 187-28-27",
                    "placeholder": "+7 (978) 187-28-27",
                    "required": 1
                },
                {
                    "key": "field_footer_contacts_email",
                    "label": "Email",
                    "name": "email",
                    "type": "email",
                    "default_value": "banquet@shen.ru",
                    "placeholder": "banquet@shen.ru",
                    "required": 1
                },
                {
                    "key": "field_footer_contacts_address",
                    "label": "Адрес",
                    "name": "address",
                    "type": "text",
                    "default_value": "г. Симферополь, ул. Генерала Васильева, 40А",
                    "placeholder": "г. Симферополь, ул. Генерала Васильева, 40А",
                    "required": 1
                },
                {
                    "key": "field_footer_contacts_hours",
                    "label": "Часы работы",
                    "name": "hours",
                    "type": "text",
                    "default_value": "Ежедневно с 09:00 до 18:00",
                    "placeholder": "Ежедневно с 09:00 до 18:00"
                }
            ]
        },
        {
            "key": "field_footer_bottom",
            "label": "Нижняя часть футера",
            "name": "footer_bottom",
