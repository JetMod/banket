                    "label": "Текст логотипа",
                    "name": "logo_text",
                    "type": "text",
                    "default_value": "SHEN",
                    "placeholder": "SHEN",
                    "required": 1
                },
                {
                    "key": "field_footer_logo_subtitle",
                    "label": "Подзаголовок логотипа",
