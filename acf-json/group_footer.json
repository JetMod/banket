            "instructions": "Настройки нижней части футера",
            "layout": "block",
            "sub_fields": [
                {
                    "key": "field_footer_copyright",
                    "label": "Текст копирайта",
                    "name": "copyright",
                    "type": "text",
                    "instructions": "Можно использовать {year} для автоматической подстановки года",
                    "default_value": "© {year} Shen Banquet Halls. Все права защищены.",
                    "placeholder": "© {year} Shen Banquet Halls. Все права защищены.",
                    "required": 1
                },
                {
                    "key": "field_footer_privacy_link",
                    "label": "Ссылка на политику конфиденциальности",
                    "name": "privacy_link",
                    "type": "group",
                    "layout": "block",
                    "sub_fields": [
                        {
                            "key": "field_footer_privacy_text",
                            "label": "Текст ссылки",
                            "name": "text",
                            "type": "text",
                            "default_value": "Политика конфиденциальности",
                            "placeholder": "Политика конфиденциальности"
                        },
                        {
                            "key": "field_footer_privacy_url",
                            "label": "URL",
                            "name": "url",
                            "type": "page_link",
                            "post_type": [
                                "page"
                            ],
                            "default_value": "/политика-конфиденциальности/"
                        }
                    ]
                }
            ]
        },
        {
            "key": "field_footer_modal",
            "label": "Модальное окно формы",
            "name": "footer_modal",
            "type": "group",
            "instructions": "Настройки модального окна для формы бронирования",
            "layout": "block",
            "sub_fields": [
                {
                    "key": "field_footer_modal_title",
                    "label": "Заголовок модального окна",
                    "name": "title",
                    "type": "text",
                    "default_value": "Забронировать зал",
                    "placeholder": "Забронировать зал",
                    "required": 1
                },
                {
                    "key": "field_footer_modal_subtitle",
                    "label": "Подзаголовок",
                    "name": "subtitle",
                    "type": "textarea",
                    "rows": 2,
                    "default_value": "Оставьте заявку и мы свяжемся с вами в ближайшее время",
                    "placeholder": "Оставьте заявку и мы свяжемся с вами в ближайшее время"
                },
                {
                    "key": "field_footer_modal_aria_close",
                    "label": "ARIA label для кнопки закрытия",
                    "name": "aria_close",
                    "type": "text",
                    "default_value": "Закрыть модальное окно",
                    "placeholder": "Закрыть модальное окно"
                }
